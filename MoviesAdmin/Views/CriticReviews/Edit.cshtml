@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Edit Review";
}

<h1>Edit Review</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MovieId" />
            <input type="hidden" asp-for="CreatedDate" />

            @* The movie can't be changed on an existing review *@
            <div class="mb-3">
                <label class="form-label d-block">Movie</label>
                <span>@Model.Movie.Title</span>
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="form-label"></label>
                <input asp-for="Rating" type="number" min="1" max="5" step="1" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="6" maxlength="1000"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <div class="form-text">Maximum 1000 characters.</div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label">Publish now</label>
                <div class="form-text">Leave unchecked to keep this as a draft. Once published, a review can no longer be edited or deleted.</div>
            </div>

            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}