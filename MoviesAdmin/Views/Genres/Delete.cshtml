@model MoviesAdmin.Models.Genre

@{
    ViewData["Title"] = "Delete Genre";

    // number of movies that still use this genre (set by the controller)
    int movieCount = ViewBag.MovieCount;
    bool inUse = movieCount > 0;
}

<h1>Delete Genre</h1>

@if (inUse)
{
    <h3>This genre can't be deleted</h3>
}
else
{
    <h3>Are you sure you want to delete "@Model.Title"?</h3>
}
<hr />

<div class="details-box">
    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Title)</div>
        <div class="col-sm-9 details-value">@Html.DisplayFor(model => model.Title)</div>
    </div>
</div>

@if (inUse)
{
    @* Genre is still used by movies: explain why and what to do, no Delete button *@
    <div class="notice-box mt-3" role="alert">
        <strong>"@Model.Title"</strong> is still used by @(movieCount == 1 ? "1 movie" : movieCount + " movies").
        To delete this genre, first change @(movieCount == 1 ? "that movie" : "those movies") to a different genre.
    </div>

    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary mt-3">View Movies</a>
    <a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to List</a>
}
else
{
    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary ">Back to List</a>
    </form>
}