@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Runtime" class="form-label"></label>
                <input asp-for="Runtime" class="form-control" />
                <span asp-validation-for="Runtime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GenreId" class="control-label fw-bold"></label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId"></select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AudienceRating" class="control-label fw-bold"></label>
                <select asp-for="AudienceRating" class="form-select" asp-items="ViewBag.AudienceRatingId"></select>
                <span asp-validation-for="AudienceRating" class="text-danger"></span>
            </div> 

            <div class="mb-3">
                <label asp-for="Synopsis" class="form-label"></label>
                <textarea asp-for="Synopsis" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Synopsis" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReleaseDate" class="form-label"></label>
                <input asp-for="ReleaseDate" type="date" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FunFact" class="form-label"></label>
                <input asp-for="FunFact" class="form-control" />
                <span asp-validation-for="FunFact" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Directors" class="form-label"></label>
                <input asp-for="Directors" class="form-control" />
                <span asp-validation-for="Directors" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="imageFile" class="form-label">Poster image</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control" />
                <span class="text-danger">@Html.ValidationMessage("imageFile")</span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-primary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}