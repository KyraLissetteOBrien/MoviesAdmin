@model MoviesAdmin.Models.Movie
@using Microsoft.AspNetCore.Html

@{
    ViewData["Title"] = "Delete";

    // turn line breaks typed in the textarea into <br /> so paragraphs display as paragraphs
    // (HtmlEncode first so any < or & typed by the user is shown as text, not as HTML)
    var descriptionWithBreaks = new HtmlString(
        System.Net.WebUtility.HtmlEncode(Model.Description)
            .Replace("\r\n", "<br />")
            .Replace("\n", "<br />")
            .Replace("\r", "<br />"));

    var synopsisWithBreaks = new HtmlString(
        System.Net.WebUtility.HtmlEncode(Model.Synopsis)
            .Replace("\r\n", "<br />")
            .Replace("\n", "<br />")
            .Replace("\r", "<br />"));
}

<h1>Delete Record</h1>

<h3>Are you sure you want to delete this?</h3>
<hr />

@* border-danger turns the outer border of the box red *@
<div class="details-box">
    <div class="row details-row">
        <div class="col-sm-3 details-label">Poster</div>
        <div class="col-sm-9 details-value">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Poster for @Model.Title" class="poster-large" />
            }
            else
            {
                <span>No poster</span>
            }
        </div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Title)</div>
        <div class="col-sm-9 details-value">@Html.DisplayFor(model => model.Title)</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Description)</div>
        <div class="col-sm-9 details-value">@descriptionWithBreaks</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Runtime)</div>
        <div class="col-sm-9 details-value">@Html.DisplayFor(model => model.Runtime)</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">Genre</div>
        <div class="col-sm-9 details-value">@Model.Genre?.Title</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">Rating</div>
        <div class="col-sm-9 details-value">@Model.AudienceRating?.Title</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Synopsis)</div>
        <div class="col-sm-9 details-value">@synopsisWithBreaks</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.ReleaseDate)</div>
        <div class="col-sm-9 details-value">@Html.DisplayFor(model => model.ReleaseDate)</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.FunFact)</div>
        <div class="col-sm-9 details-value">@Html.DisplayFor(model => model.FunFact)</div>
    </div>

    <div class="row details-row">
        <div class="col-sm-3 details-label">@Html.DisplayNameFor(model => model.Directors)</div>
        <div class="col-sm-9 details-value">@Html.DisplayFor(model => model.Directors)</div>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</form>