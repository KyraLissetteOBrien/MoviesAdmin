@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="mt-5">Welcome to Lengthy Lemons</h1>
    <h2 class="fst-italic mb-4">home of the longest films</h2>

    @* <p class="lead mb-4">
        We're collecting the lengthiest movies ever made. Critics and Administrators, log in to get started.
    </p> *@
    @* <h3 class="mb-4">Thank you for taking part</h3> *@

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Movies" asp-action="Index" class="btn btn-primary me-2">All Movies</a>

        @if (User.IsInRole("administrator"))
        {
            <a asp-controller="Movies" asp-action="Create" class="btn btn-primary">Add New Entry</a>
        }
        else if (User.IsInRole("critic"))
        {
            <a asp-controller="CriticReviews" asp-action="Index" class="btn btn-primary">My Reviews</a>
        }
    }
    else
    {
        <p class="mb-3">Critics and Administrators, log in to get started.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
    }
</div>