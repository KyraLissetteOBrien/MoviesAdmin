@{
    int code = ViewBag.Code;
    ViewData["Title"] = code == 404 ? "Page Not Found" : "Error";
}

<div class="text-center">
    @if (code == 404)
    {
        <h1 class="mt-5">Page Not Found</h1>
        <p class="lead mb-4">We couldn't find the page you were looking for.</p>
    }
    else
    {
        <h1 class="mt-5">Something Went Wrong</h1>
        <p class="lead mb-4">Sorry, we couldn't open that page.</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
</div>