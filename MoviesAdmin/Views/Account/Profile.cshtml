@{
    ViewData["Title"] = "User Profile";
    var fallback = User.FindFirst(c => c.Type == "picture")?.Value;
}

<div class="row">
    <div class="col-md-12">
        <h2>@ViewData["Title"]</h2>
        <div class="row">
            <div class="col-md-2">
                <img id="avatar" src="/avatar/me" alt="User's profile picture"
                     class="img-fluid rounded-circle"
                     style="aspect-ratio:1/1; object-fit:cover;"
                     onerror="this.onerror=null; this.src='@fallback';" />

                <form method="post" action="/avatar/upload" enctype="multipart/form-data" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="photo" accept="image/*" class="form-control form-control-sm mb-1" />
                    <button type="submit" class="btn btn-sm btn-primary">Upload photo</button>
                </form>
            </div>
            <div class="col-md-10">
                <h3>@User.Identity.Name</h3>
                <p><strong>Email:</strong> @User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</p>
                <p><strong>Email Verified:</strong> @User.FindFirst(c => c.Type == "email_verified")?.Value</p>
                <p><strong>User ID:</strong> @User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</p>
            </div>
        </div>

        <h4 class="mt-4">User Claims</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Claim Type</th>
                    <th>Claim Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in User.Claims)
                {
                    <tr>
                        <td>@claim.Type</td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>